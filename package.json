{
  "name": "unveil",
  "productName": "Unveil",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "description": "A light Chromium fork for Windows with no tracking.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "shell:build": "node chromium/shell/build.mjs",
    "shell:watch": "node chromium/shell/build.mjs --watch",
    "shell:typecheck": "tsc -p chromium/shell && tsc -p chromium/shell/test/unit",
    "typecheck": "npm run shell:typecheck",
    "test": "node --test \"chromium/shell/test/unit/*.test.*\" \"chromium/scripts/test/*.test.*\"",
    "test:e2e": "node --test \"chromium/shell/test/e2e/*.test.*\"",
    "check-patches": "node chromium/scripts/check-patches.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
