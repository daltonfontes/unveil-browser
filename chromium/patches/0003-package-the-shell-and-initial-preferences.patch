--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -72,6 +72,17 @@
   # signing identity. If `include_branded_entitlements` is set to false, these
   # entitlements will be skipped.
   include_branded_entitlements = true
+
+  # Unveil: a source-absolute path ("//...") to the built shell extension
+  # (chromium/shell/dist in the Unveil repo), copied beside chrome.dll as
+  # unveil_shell, where ComponentLoader looks without --unveil-shell-dir.
+  # build-release.ps1 stages the shell at //unveil/shell and sets this. Empty
+  # (dev builds, which pass --unveil-shell-dir) copies none.
+  unveil_shell_dir = ""
+
+  # Unveil: a source-absolute path to Unveil's initial_preferences (its
+  # privacy defaults for new profiles), copied beside chrome.exe.
+  unveil_initial_preferences = ""
 }
 
 assert(!is_ios, "Chromium/iOS shouldn't use anything in //chrome")
@@ -192,6 +203,13 @@
     }
 
     if (is_win) {
+      if (unveil_shell_dir != "") {
+        data_deps += [ ":unveil_shell" ]
+      }
+      if (unveil_initial_preferences != "") {
+        data_deps += [ ":unveil_initial_preferences" ]
+      }
+
       sources += [
         "app/chrome_exe.rc",
         "app/chrome_exe_main_win.cc",
@@ -485,6 +503,20 @@
     outputs = [ "$root_out_dir/First Run" ]
   }
 
+  if (unveil_shell_dir != "") {
+    copy("unveil_shell") {
+      sources = [ unveil_shell_dir ]
+      outputs = [ "$root_out_dir/unveil_shell" ]
+    }
+  }
+
+  if (unveil_initial_preferences != "") {
+    copy("unveil_initial_preferences") {
+      sources = [ unveil_initial_preferences ]
+      outputs = [ "$root_out_dir/initial_preferences" ]
