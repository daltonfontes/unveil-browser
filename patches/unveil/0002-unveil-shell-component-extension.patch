+namespace {
+
+// Unveil: the shell's manifest and the folder to load it from. A packaged
+// shell is copied into the user data folder first (once per shell version),
+// because declarativeNetRequest writes its indexed rulesets into the
+// extension's own folder, and the install folder can be read-only (a
+// system-level install in Program Files).
+std::pair<base::FilePath, std::optional<base::DictValue>> PrepareUnveilShell(
+    const base::FilePath& dir,
+    bool copy_to_user_data) {
+  std::string error;
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(dir, &error);
+  if (!manifest) {
+    LOG(ERROR) << "Unveil's shell couldn't load from " << dir << ": " << error;
+    return {dir, std::nullopt};
+  }
+  base::FilePath user_data;
+  const std::string* version = manifest->FindString(manifest_keys::kVersion);
+  if (!copy_to_user_data || !version ||
+      !base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    return {dir, std::move(manifest)};
+  }
+  const base::FilePath copies =
+      user_data.Append(FILE_PATH_LITERAL("Unveil Shell"));
+  const base::FilePath copy = copies.AppendASCII(*version);
+  if (base::PathExists(copy.Append(kManifestFilename))) {
+    return {copy, std::move(manifest)};
+  }
+  // Older versions' copies go; this one is copied beside and moved in, so a
+  // half-made copy is never loaded.
+  base::DeletePathRecursively(copies);
+  const base::FilePath partial = copies.AppendASCII(*version + ".partial");
+  if (!base::CreateDirectory(copies) ||
+      !base::CopyDirectory(dir, partial, /*recursive=*/true) ||
+      !base::Move(partial, copy)) {
+    LOG(ERROR) << "Unveil's shell couldn't be copied to " << copy
+               << "; loading it from " << dir;
+    base::DeletePathRecursively(partial);
+    return {dir, std::move(manifest)};
+  }
+  return {copy, std::move(manifest)};
+}
+
+}  // namespace
+
+void ComponentLoader::AddUnveilShellExtension() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  base::FilePath dir = command_line->GetSwitchValuePath("unveil-shell-dir");
+  // A dev build's shell/dist is writable and changes in place, so it loads
+  // from where it is.
+  const bool copy_to_user_data = dir.empty();
+  if (dir.empty()) {
+    // Release builds carry the shell beside chrome.dll (the unveil_shell_dir
+    // GN arg in chrome/BUILD.gn, and chrome.release for the installer).
+    if (!base::PathService::Get(base::DIR_ASSETS, &dir)) {
+      return;
+    }
+    dir = dir.Append(FILE_PATH_LITERAL("unveil_shell"));
+  }
+  if (!dir.IsAbsolute()) {
+    LOG(ERROR) << "--unveil-shell-dir must be an absolute path: " << dir;
+    return;
+  }
+  // The files are read and copied on the extension file task runner; Add() in
+  // the reply loads the shell straight away if the extension system is ready.
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&PrepareUnveilShell, dir, copy_to_user_data),
+      base::BindOnce(&ComponentLoader::FinishAddUnveilShell,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ComponentLoader::FinishAddUnveilShell(
+    std::pair<base::FilePath, std::optional<base::DictValue>> shell) {
+  auto& [dir, manifest] = shell;
+  if (!manifest) {
+    return;
+  }
+  const ExtensionId id =
+      Add(std::move(*manifest), dir, /*skip_allowlist=*/false);
+  if (id != extension_misc::kUnveilShellExtensionId) {
+    LOG(ERROR) << "Unveil's shell at " << dir << " has the id " << id
+               << "; its manifest key must give "
+               << extension_misc::kUnveilShellExtensionId;
+  }
+}
