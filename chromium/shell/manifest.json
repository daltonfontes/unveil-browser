{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "sidePanel",
    "alarms",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Unveil",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist",
        "enabled": true,
        "path": "rules/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rules/easyprivacy.json"
      },
      {
        "id": "tracking_params",
        "enabled": true,
        "path": "rules/tracking_params.json"
      }
    ]
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "__MSG_cmdToggleSidebar__"
    },
    "next-space": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "__MSG_cmdNextSpace__"
    },
    "previous-space": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "__MSG_cmdPreviousSpace__"
    },
    "split-view": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSplitView__"
    }
  }
}
