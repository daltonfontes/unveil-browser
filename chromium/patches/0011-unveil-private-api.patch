+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UNVEIL_UNVEIL_SPACES_H_
+#define CHROME_BROWSER_UNVEIL_UNVEIL_SPACES_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+// Spaces with separate cookies, as in Flecha (MIT, github.com/
+// lucianodiisouza/flecha-browser, patch 0034, which this follows). The tabs of
+// such a Space live in a storage partition of their own: cookies,
+// localStorage, IndexedDB, service workers, cache and the rest, on disk under
+// <profile>/Storage/ext/unveil-space/<hash of the name>, so a login stays
+// across restarts. The shell names the partition (the Space's id) and opens
+// the Space's tabs in it (chrome.unveilPrivate.createTab).
+//
+// A storage partition and not a profile per Space: a profile has its own
+// extensions and its own windows, so the shell and its sidebar would have to
+// be split across profiles, and a Space's tabs couldn't share the window with
+// the others. A partition keeps everything else (the window, the shell,
+// history, passwords, settings) and separates only what sites store.
+//
+// A tab's partition is fixed for its life: its SiteInstance is made with
+// SiteInstance::CreateForFixedStoragePartition(), which Chromium keeps across
+// navigations, cross-site ones and new BrowsingInstances included (as for
+// <webview>). Tabs a page opens stay in its partition: window.open() shares
+// the opener's BrowsingInstance, and links to a new tab (noopener, "Open Link
+// in New Tab") inherit it (UnveilSiteInstanceFor()). A tab moving to another
+// Space can't change partition, so the shell closes it and opens it again in
+// the other one.
+//
+// Header-only: every user already depends on //content/public/browser.
+
+inline constexpr char kUnveilSpacePartitionDomain[] = "unveil-space";
+
+// The storage partition of the Space named `name` (the shell's Space id). In
+// an off-the-record profile it is in memory, like the rest of that profile.
+inline content::StoragePartitionConfig UnveilSpacePartition(
+    content::BrowserContext* context,
+    const std::string& name) {
+  return content::StoragePartitionConfig::Create(
+      context, kUnveilSpacePartitionDomain, name, context->IsOffTheRecord());
+}
+
+inline bool IsUnveilSpacePartition(
+    const content::StoragePartitionConfig& config) {
+  return !config.is_default() &&
+         config.partition_domain() == kUnveilSpacePartitionDomain;
+}
+
+// The Space partition `contents` is in, or "" (the profile's own storage).
+inline std::string UnveilSpaceOf(content::WebContents* contents) {
+  if (!contents) {
+    return std::string();
+  }
+  const content::StoragePartitionConfig& config =
+      contents->GetSiteInstance()->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  return IsUnveilSpacePartition(config) ? config.partition_name()
+                                        : std::string();
+}
+
+// A SiteInstance in a new BrowsingInstance for `url`, in the Space partition
+// `source` is in; null when `source` is in the profile's own storage (then
+// the caller makes its SiteInstance as usual).
+inline scoped_refptr<content::SiteInstance> UnveilSiteInstanceFor(
+    content::WebContents* source,
+    const GURL& url) {
+  if (!source) {
+    return nullptr;
+  }
+  const content::StoragePartitionConfig& config =
+      source->GetSiteInstance()->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  if (!IsUnveilSpacePartition(config)) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(
+      source->GetBrowserContext(), url, config);
+}
+
+// Where the Space partitions live, relative to the profile directory; kept
+// when Chromium garbage-collects storage partitions it doesn't know.
+inline base::FilePath UnveilSpacePartitionsPath() {
+  return base::FilePath(FILE_PATH_LITERAL("Storage"))
+      .Append(FILE_PATH_LITERAL("ext"))
+      .AppendASCII(kUnveilSpacePartitionDomain);
+}
+
+#endif  // CHROME_BROWSER_UNVEIL_UNVEIL_SPACES_H_
