--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -72,6 +72,17 @@ declare_args() {
   # signing identity. If `include_branded_entitlements` is set to false, these
   # entitlements will be skipped.
   include_branded_entitlements = true
+
+  # Unveil: a source-absolute path ("//...") to the built shell extension
+  # (chromium/shell/dist in the Unveil repo), copied beside the browser as
+  # unveil_shell, where ComponentLoader looks without --unveil-shell-dir.
+  # build-release.ps1 stages the shell at //unveil/shell and sets this. Empty
+  # (dev builds, which pass --unveil-shell-dir) copies none.
+  unveil_shell_dir = ""
+
+  # Unveil: a source-absolute path to Unveil's initial_preferences (its
+  # privacy defaults for new profiles), copied beside the browser.
+  unveil_initial_preferences = ""
 }
 
 assert(!is_ios, "Chromium/iOS shouldn't use anything in //chrome")
@@ -182,6 +193,15 @@ if (!is_android && !is_mac) {
       deps += [ "//components/webapps/isolated_web_apps:scheme" ]
     }
 
+    # Unveil: the shell and initial_preferences beside the browser, on
+    # every platform (Windows, Linux).
+    if (unveil_shell_dir != "") {
+      data_deps += [ ":unveil_shell" ]
+    }
+    if (unveil_initial_preferences != "") {
+      data_deps += [ ":unveil_initial_preferences" ]
+    }
+
     if (is_chromeos) {
       data_deps += [ "//sandbox/linux:chrome_sandbox" ]
       if (build_mojo_proxy) {
@@ -419,6 +439,21 @@ if (!is_android && !is_mac) {
   }
 }  # !is_android && !is_mac
 
+# Unveil: copied beside the browser (see unveil_shell_dir above).
+if (unveil_shell_dir != "") {
+  copy("unveil_shell") {
+    sources = [ unveil_shell_dir ]
+    outputs = [ "$root_out_dir/unveil_shell" ]
+  }
+}
+
+if (unveil_initial_preferences != "") {
+  copy("unveil_initial_preferences") {
+    sources = [ unveil_initial_preferences ]
+    outputs = [ "$root_out_dir/initial_preferences" ]
+  }
+}
+
 if (is_win) {
   shared_library("chrome_dll") {
     configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
--- a/chrome/installer/mini_installer/chrome.release
+++ b/chrome/installer/mini_installer/chrome.release
@@ -8,6 +8,8 @@
 #
 chrome.exe: %(ChromeDir)s\
 chrome_proxy.exe: %(ChromeDir)s\
+# Unveil's privacy defaults for new profiles, read from beside chrome.exe.
+initial_preferences: %(ChromeDir)s\
 #
 # Chrome version dir assembly manifest.
 # The name of this file must match the name of the version dir, so we cannot
@@ -43,6 +45,16 @@ v8_context_snapshot.bin: %(VersionDir)s\
 #
 Extensions\*.*: %(VersionDir)s\Extensions\
 locales\*.pak: %(VersionDir)s\Locales
+#
+# Unveil's shell extension (ComponentLoader::AddUnveilShellExtension). These
+# globs aren't recursive: keep them in step with the folders in
+# chromium/shell/dist.
+#
+unveil_shell\*.*: %(VersionDir)s\unveil_shell\
+unveil_shell\_locales\en\*.*: %(VersionDir)s\unveil_shell\_locales\en\
+unveil_shell\_locales\pt_BR\*.*: %(VersionDir)s\unveil_shell\_locales\pt_BR\
+unveil_shell\icons\*.*: %(VersionDir)s\unveil_shell\icons\
+unveil_shell\rules\*.*: %(VersionDir)s\unveil_shell\rules\
 
