+// Ported from Flecha's flechaPrivate.createTab (MIT, github.com/
+// lucianodiisouza/flecha-browser): tabs.create(), with a storage partition.
+ExtensionFunction::ResponseAction UnveilPrivateCreateTabFunction::Run() {
+  auto params = unveil_private::CreateTab::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const unveil_private::CreateTabOptions& options = params->options;
+
+  std::string error;
+  WindowController* window = ExtensionTabUtil::GetControllerFromWindowID(
+      ChromeExtensionFunctionDetails(this), options.window_id, &error);
+  if (!window || !window->GetBrowserWindowInterface()) {
+    return RespondNow(Error(error.empty() ? "No window" : error));
+  }
+  GURL url(chrome::kChromeUINewTabURL);
+  if (options.url && !options.url->empty()) {
+    url = GURL(*options.url);
+    if (!url.is_valid()) {
+      return RespondNow(Error("Invalid url: " + *options.url));
+    }
+  }
+
+  // The SiteInstance decides the storage partition, for the tab's life.
+  content::BrowserContext* context = browser_context();
+  const std::string partition = options.partition.value_or(std::string());
+  scoped_refptr<content::SiteInstance> site_instance =
+      partition.empty()
+          ? content::SiteInstance::CreateForURL(context, url)
+          : content::SiteInstance::CreateForFixedStoragePartition(
+                context, url, UnveilSpacePartition(context, partition));
+  const bool active = options.active.value_or(true);
+  content::WebContents::CreateParams create_params(context,
+                                                    std::move(site_instance));
+  create_params.initially_hidden = !active;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(create_params);
+  content::WebContents* raw = contents.get();
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                    std::string());
+  window->GetBrowserWindowInterface()->GetTabStripModel()->AddWebContents(
+      std::move(contents), TabStripModel::kNoTab,
+      ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+      active ? AddTabTypes::ADD_ACTIVE : AddTabTypes::ADD_NONE);
+  return RespondNow(WithArguments(ExtensionTabUtil::GetTabId(raw)));
+}
+
+ExtensionFunction::ResponseAction UnveilPrivateGetTabPartitionFunction::Run() {
+  auto params = unveil_private::GetTabPartition::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(
+        Error("No tab with id " + base::NumberToString(params->tab_id)));
+  }
+  return RespondNow(WithArguments(UnveilSpaceOf(contents)));
+}
+
+ExtensionFunction::ResponseAction UnveilPrivateClearPartitionFunction::Run() {
+  auto params = unveil_private::ClearPartition::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (params->partition.empty()) {
+    return RespondNow(Error("Only a Space's own partition can be cleared."));
+  }
+  content::StoragePartition* partition = browser_context()->GetStoragePartition(
+      UnveilSpacePartition(browser_context(), params->partition));
+  // Cookies (session ones too), every kind of site storage, and the cache.
+  auto cookies = network::mojom::CookieDeletionFilter::New();
+  cookies->session_control =
+      network::mojom::CookieDeletionSessionControl::IGNORE_CONTROL;
+  pending_ = 2;
+  partition->ClearData(
+      content::StoragePartition::REMOVE_DATA_MASK_ALL,
+      /*filter_builder=*/nullptr,
+      content::StoragePartition::StorageKeyPolicyMatcherFunction(),
+      std::move(cookies), /*perform_storage_cleanup=*/true, base::Time(),
+      base::Time::Max(),
+      base::BindOnce(&UnveilPrivateClearPartitionFunction::OnCleared, this));
+  partition->GetNetworkContext()->ClearHttpCache(
+      base::Time(), base::Time::Max(), /*filter=*/nullptr,
+      base::BindOnce(&UnveilPrivateClearPartitionFunction::OnCleared, this));
+  return RespondLater();
+}
+
+void UnveilPrivateClearPartitionFunction::OnCleared() {
+  if (--pending_ == 0) {
+    Respond(NoArguments());
+  }
+}
+
+}  // namespace extensions
